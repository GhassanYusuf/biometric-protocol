<?xml version="1.0" encoding="UTF-8"?>
<!--
    Standalone test config, for running the library outside this repository.

    No bootstrap beyond composer's autoloader and no device: every test here works
    on captured bytes. If a test in this package needs a network, it is in the wrong
    package.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
